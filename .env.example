# Optional: set this to the URL that receives JSON from your vital-sign device.
# The endpoint may use either the existing Flask keys ("Heart Rate", "SpO2", "BP")
# or the normalized keys (heartRate, spo2, bloodPressure, temperature, glucose).
VITALS_API_URL=http://localhost:5000/api/health

# Live kiosk readings. Firebase takes precedence over VITALS_API_URL.
MEDIKET_FIREBASE_URL=https://mediket-fyp-default-rtdb.asia-southeast1.firebasedatabase.app
MEDIKET_FIREBASE_AUTH=
MEDIKET_VITALS_PATH=users/patient_001/vitals/latest

# Blood pressure only, on the Live device dashboard. Server-only Firebase values.
BP_FIREBASE_URL=https://project-a0538-default-rtdb.asia-southeast1.firebasedatabase.app/latest.json
BP_FIREBASE_AUTH=

# BP trigger only: ON for 2 seconds, then OFF at /control/state.
BP_CONTROL_FIREBASE_URL=https://bp-and-temp-default-rtdb.asia-southeast1.firebasedatabase.app
BP_CONTROL_FIREBASE_AUTH=

# Independent temperature reading at /temperature, supplied in Fahrenheit.
TEMPERATURE_FIREBASE_URL=https://temperture-89982-default-rtdb.asia-southeast1.firebasedatabase.app
TEMPERATURE_FIREBASE_AUTH=

# ElevenLabs text-to-speech — keep these server-only values in .env.local.
# Create a restricted key in ElevenLabs; never expose it in browser code.
# Required for Tamil/Telugu audio on devices without installed voices.
# Tamil uses Flash v2.5 and Telugu uses v3; the voice must be available to your key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional exact text translation before audio is generated.
# Enable Google Cloud Translation API and use a server-restricted key only.
GOOGLE_TRANSLATE_API_KEY=

# Local ML research API used by the Live device ML result card.
MEDIKET_ML_ORIGIN=http://127.0.0.1:8001

# Local Ganache CLI collector configuration (optional defaults).
GANACHE_RPC_URL=http://127.0.0.1:7447
GANACHE_LEDGER_DIR=.blockchain/ledger-7447
